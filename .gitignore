# Literature PDFs are NOT redistributable. Most items in refs/ are under publisher
# copyright (Elsevier, IEEE, Springer, Thieme, Wiley). refs/REFERENCES.md lists DOIs
# and open-access status so each collaborator can obtain their own copies.
# Do not remove these rules without checking the licence of every file you are adding.
refs/*.pdf
refs/*.epub
refs/*.djvu
*.pdf
!docs/figures/*.pdf

# Raw measurement data and large binaries: keep out of git, use a data store
*.wav
*.mat
*.npy
*.h5
*.hdf5
*.tdms
*.csv.gz

# Scratch
*.bak
*.bak-*
*.tmp
~$*
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Slicer output is derived: regenerate with flow/slice_print.py from the STL plus the
# profiles in flow/gcode/*.json. The frame alone is 3.7 MB of toolpath and it changes
# with every nozzle, layer height or filament choice, so it does not belong in history.
*.gcode
*.3mf
# OrcaSlicer CLI drops this next to the output when it cannot make a thumbnail
[0-9][0-9][0-9][0-9][0-9].log
